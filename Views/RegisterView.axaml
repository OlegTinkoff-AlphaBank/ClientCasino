<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CasinoClient.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="CasinoClient.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             Background="#0D0F14">
    <Grid>
        <Border Classes="card" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Создайте аккаунт, чтобы начать" Foreground="#8A8F9C" FontSize="13" Margin="0,-8,0,4" />

                <TextBox Text="{Binding Username}" Watermark="Имя пользователя" />
                <TextBox Text="{Binding Email}" Watermark="Email" />
                <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Пароль" />
                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" Watermark="Повторите пароль" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F0576B" FontSize="13" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                <Button Content="Зарегистрироваться" Classes="primary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}"
                        Command="{Binding RegisterCommand}" Margin="0,4,0,0" />

                <Button Content="Уже есть аккаунт? Войти" Classes="secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}"
                        Command="{Binding GoToLoginCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
